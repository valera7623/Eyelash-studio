# Скопируйте в .env. BOT_TOKEN обязателен для python -m src.main.
# Для create_tables.py токен можно не задавать.
BOT_TOKEN=000000:your_token_here

# Username бота без @ (для QR и ссылок, если getMe недоступен).
BOT_USERNAME=

# Опционально: прокси до api.telegram.org.
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Админы платформы (саппорт продукта). JSON или через запятую.
ADMINS=[]
# SUPERADMINS=[]

# SQLite. ПДн только на хостинге в РФ.
# SQLITE_PATH=data/eyelash.db

# FSM: Redis в проде.
# USE_REDIS=false
# REDIS_URL=redis://localhost:6379/0

# --- Оплата: ЮKassa (предпочтительно) или Prodamus. ---
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# PAYMENT_PROVIDER=auto
# PRODAMUS_SECRET=
# PRODAMUS_PAYFORM_URL=

# HTTP: лендинг, webhook, iCal. 0 — выключить.
# На VPS вместе со studio-book: HTTP_PORT=8089, Redis 6380.
# HTTP_PORT=8088
# PUBLIC_BASE_URL=

# Прод-образ (GitHub Actions пишет сам):
# DOCKER_IMAGE=ghcr.io/valera7623/eyelash-studio:latest

# HOLD_TTL_MINUTES=20
# FREE_RESOURCE_LIMIT=1
# FREE_BOOKINGS_PER_MONTH=10
# TARIFF_STARTER_RUB=490
# CONSENT_PDN_VERSION=1
